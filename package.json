{
  "name": "lifechange-rn",
  "version": "1.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "build": "cd android && ./gradlew.bat assembleDebug",
    "make-apk": "cd android && ./gradlew.bat assembleRelease",
    "make-release": "cd android && ./gradlew.bat bundleRelease",
    "clean": "powershell.exe -NoProfile -Command \"Remove-Item -LiteralPath 'android/app/.cxx' -Recurse -Force -ErrorAction SilentlyContinue; Push-Location android; & '.\\gradlew.bat' clean; Pop-Location\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "axios": "1.18.1",
    "moment-timezone": "0.6.2",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-android-widget": "0.20.3",
    "react-native-dotenv": "3.4.11",
    "react-native-gesture-handler": "3.0.2",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-private-methods": "8.0.1",
    "@babel/plugin-transform-typescript": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@biomejs/biome": "2.5.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "30.4.1",
    "babel-plugin-module-resolver": "5.0.3",
    "esbuild": "0.28.1",
    "globals": "^17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.5",
    "react-test-renderer": "19.2.7",
    "ts-morph": "28.0.0",
