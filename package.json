{
  "name": "lifechange_rn",
  "version": "1.2.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx react-native run-android",
    "build": "cd android && gradlew clean && gradlew assembleRelease --stacktrace",
    "make-apk": "cd android && gradlew assembleRelease --stacktrace",
    "make-bundle": "cd android && gradlew bundleRelease --stacktrace",
    "watch": "bun .node/swc.cjs --bun --watch",
    "reset": "bun .node/reset.cjs --bun --reset",
    "fix": "bun .node/fix.cjs --bun --fix",
    "compile-client": "bun .node/swc.cjs --bun --compile --client",
    "compile-server": "bun .node/swc.cjs --bun --compile --server",
    "git-fetch": "bun .node/git.cjs --bun --fetch",
    "git-push": "bun .node/git.cjs --bun --push"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "1.13.2",
    "moment-timezone": "0.6.0",
    "react": "19.2.0",
    "react-native": "0.82.1",
    "react-native-android-widget": "0.17.2",
    "react-native-dotenv": "3.4.11",
    "react-native-gesture-handler": "2.29.1",
    "react-native-google-mobile-ads": "16.0.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.18.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-transform-private-methods": "7.27.1",
    "@babel/plugin-transform-typescript": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/gradle-plugin": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react": "19.2.5",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "30.2.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "9.39.1",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "react-test-renderer": "19.2.0",
    "typescript": "5.9.3"
  }
}
